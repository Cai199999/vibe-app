# ============ 应用 ============
APP_NAME=vibe-app
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# ============ MySQL（复用宿主机 Docker 实例） ============
MYSQL_DSN=mysql+pymysql://root:root@127.0.0.1:3306/geo_ai_db?charset=utf8mb4

# ============ Redis ============
REDIS_URL=redis://127.0.0.1:6379/0

# ============ MinIO ============
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
MINIO_BUCKET=vibe-app
MINIO_SECURE=false

# ============ Prompt 服务 ============
# 模型提供方：mock / deepseek / ollama
# 旧变量 PROMPT_PROVIDER 仍兼容；两者同时存在时 LLM_PROVIDER 优先。
LLM_PROVIDER=mock
# 发送给模型前脱敏：邮箱 / 手机号 / AK/SK / Token 等替换为 [REDACTED]
REDACT_SENSITIVE=true
# 默认 false：仅允许 localhost / 127.0.0.1 / ::1 项目；
# true：允许任意合法 http(s) 的 Vite + React 项目（危险端口始终拦截）。
ALLOW_REMOTE_PROJECTS=false
# 画布开发服务器的精确 Origin，逗号分隔，禁止使用 *
ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# ============ DeepSeek（LLM_PROVIDER=deepseek） ============
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 携带截图 image_base64 时使用的多模态模型
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_TOKENS=2000
DEEPSEEK_TEMPERATURE=0.2

# ============ Ollama（LLM_PROVIDER=ollama） ============
# 本地或局域网地址；也可填写带 /v1 的 OpenAI 兼容网关地址。
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# 留空表示不支持截图；视觉模型示例：qwen2.5vl:7b / llava:7b
OLLAMA_VISION_MODEL=
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_TOKENS=2000
OLLAMA_TEMPERATURE=0.2
# 本地小模型上下文保护：JSX 片段超过该字符数时截断并加提示
OLLAMA_MAX_SNIPPET_CHARS=2000
# 直连 Ollama 留空；经反向代理 / 网关时填写
OLLAMA_API_KEY=
