# ============ 应用 ============
APP_NAME=vibe-app
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# ============ MySQL（复用宿主机 Docker 实例） ============
MYSQL_DSN=mysql+pymysql://root:root@127.0.0.1:3306/geo_ai_db?charset=utf8mb4

# ============ Redis ============
REDIS_URL=redis://127.0.0.1:6379/0

# ============ MinIO ============
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
MINIO_BUCKET=vibe-app
MINIO_SECURE=false

# ============ Prompt 服务 ============
# mock：本地固定 Markdown，不联网；deepseek：调用真实 API
PROMPT_PROVIDER=mock
# 默认 false：仅允许 localhost / 127.0.0.1 / ::1 项目；
# true：允许任意合法 http(s) 的 Vite + React 项目（危险端口始终拦截）。
ALLOW_REMOTE_PROJECTS=false
# 画布开发服务器的精确 Origin，逗号分隔，禁止使用 *
ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# ============ AI（切换真实模型时填写） ============
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 携带截图 image_base64 时使用的多模态模型
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_TOKENS=2000
DEEPSEEK_TEMPERATURE=0.2
