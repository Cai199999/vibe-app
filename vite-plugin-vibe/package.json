{
  "name": "@vibe/vite-plugin",
  "version": "0.1.0",
  "description": "Inject data-source metadata and the Vibe Canvas preview SDK into a Vite + React dev server.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "react",
    "vibe-coding",
    "visual-editing"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "magic-string": "^0.30.21"
  },
  "peerDependencies": {
    "vite": ">=5"
  }
}
